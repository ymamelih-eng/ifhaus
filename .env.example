PORT=3000
AI_PROVIDER=anthropic
AI_FALLBACK_PROVIDER=gemini
ANTHROPIC_API_KEY=PASTE_ANTHROPIC_KEY_HERE
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=PASTE_NEW_KEY_HERE
GEMINI_MODEL=gemini-3.8-flash
GOOGLE_SHEETS_WEBHOOK_URL=PASTE_APPS_SCRIPT_EXEC_URL_HERE
LEAD_WEBHOOK_SECRET=CHANGE_ME
IFHAUS_PHONE=08505322458
# Widget'ı gömen sitenin origin'leri (virgülle). Boş = herkese açık (sadece local geliştirme).
ALLOWED_ORIGINS=https://ifhaus.com,https://www.ifhaus.com

# Meta (Facebook Messenger + Instagram DM) webhook
META_VERIFY_TOKEN=CHOOSE_A_RANDOM_STRING
META_APP_SECRET=PASTE_META_APP_SECRET_HERE
META_PAGE_ACCESS_TOKEN=PASTE_PAGE_ACCESS_TOKEN_HERE
META_GRAPH_API_VERSION=v23.0
# İsteğe bağlı:
# META_PAGE_ID=                  # boşsa /me kullanılır
# META_INSTAGRAM_ACCESS_TOKEN=   # boşsa Page token kullanılır (Messenger API for Instagram)
# META_INSTAGRAM_ACCOUNT_ID=     # boşsa /me kullanılır
# META_INSTAGRAM_GRAPH_HOST=graph.facebook.com   # Instagram Login token'ı için graph.instagram.com
